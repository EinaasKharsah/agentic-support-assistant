# Settings for Docker Compose. Copy this file to .env and change what you need.
# Every value has a default, so .env is optional.
# (Without Docker, set the same names as environment variables; see app/config.py.)

# --- LLM (Ollama) ---
OLLAMA_MODEL=qwen2.5:3b
# Inside Docker Compose the default is http://ollama:11434 (the ollama container).
# To use an Ollama that already runs on your computer, use:
# OLLAMA_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=60

# --- Agent ---
# "llm": the LLM decides and code guards it. "rules": similarity scores only.
AGENT_MODE=llm
# Below this similarity score, the question is declined without asking the LLM.
MIN_RELEVANCE=0.55
# A second card this close to the chosen one triggers the "A, B or either?" check. 0 = off.
SECOND_CHECK_GAP=0.1
# Rewrite weak searches (typos, other languages) and search again.
REWRITE_WEAK_QUERIES=true
# Re-ranking model (an empty model turns the re-ranker off). It declines only when it is clearly sure:
# the best article scores below MIN_RERANK, or the out-of-scope example wins by RERANK_OUT_OF_SCOPE_MARGIN.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
MIN_RERANK=-10.5
RERANK_OUT_OF_SCOPE_MARGIN=1.0
# If the LLM would ask "A or B?" but one article scores at least this much, answer from it.
RERANK_SURE=3.0

# --- Storage (without Docker) ---
# Qdrant server. Docker Compose sets http://qdrant:6333; empty (without Docker) = in memory.
# QDRANT_URL=http://localhost:6333
# Thumbs up/down are appended to this file (one JSON record per line).
# FEEDBACK_PATH=feedback/feedback.jsonl
